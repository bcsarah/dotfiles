[global]
    frame_color = "#d79921"
    separator_color = "#504945"

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#98971a"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#d79921"
    timeout = 8

[urgency_critical]
    background = "#3c3836"
    foreground = "#fbf1c7"
    frame_color = "#cc241d"
    timeout = 0
