" plugins 
" curl -fLo ~/.vim/autoload/plug.vim --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
call plug#begin()
    Plug 'gruvbox-community/gruvbox'
    Plug 'itchyny/lightline.vim'
    Plug 'iberianpig/ranger-explorer.vim'
    Plug 'junegunn/fzf'
    Plug 'junegunn/fzf.vim'
    Plug 'vimwiki/vimwiki'
    Plug 'mbbill/undotree'
    Plug 'jiangmiao/auto-pairs'
    Plug 'alvan/vim-closetag'
    Plug 'ap/vim-css-color'
call plug#end()


" general
set number
set relativenumber

filetype plugin indent on
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent

set incsearch
set hlsearch

set ignorecase
set smartcase

set wrap
set linebreak
set formatoptions+=w

nnoremap j gj
nnoremap k gk


" custom binds
let mapleader = " "

noremap <leader>e :RangerOpenCurrentFile<CR>
noremap <leader>r :source ~/.vim/vimrc<CR>
noremap <leader>ff :Files<CR>
noremap <leader>fo :History<CR>
noremap <leader>fg :Rg<CR>


" clipboard
nnoremap <leader>y yy:call system('xclip -selection clipboard', @")<CR>
xnoremap <leader>y :w !xclip -selection clipboard<CR><CR>
nnoremap <leader>p :let @" = system('xclip -o -selection clipboard')<CR>p


" persistent undo
if has('persistent_undo')
  set undofile

  if !isdirectory($HOME . '/.vim/undo')
    call mkdir($HOME . '/.vim/undo', 'p')
  endif

  set undodir=$HOME/.vim/undo
endif


" theme
filetype plugin on
syntax on
set nocompatible
set laststatus=2
set termguicolors
set background=dark

colorscheme gruvbox
let g:gruvbox_contrast_dark = 'medium'
let g:lightline = {'colorscheme': 'wombat'}

" vimwiki
let g:vimwiki_list = [{
    \ 'path': '~/notes/*',
    \ 'syntax': 'markdown',
    \ 'ext': '.md',
    \ 'links_space_char': '-'
\ }]

augroup VimWikiColors
    autocmd!
    autocmd FileType vimwiki call s:VimWikiHighlights()
augroup END

function! s:VimWikiHighlights()
    highlight VimwikiHeader1 guifg=#fabd2f gui=bold
    highlight VimwikiHeader2 guifg=#fe8019 gui=bold
    highlight VimwikiHeader3 guifg=#8ec07c gui=bold

    highlight VimwikiBold guifg=#fabd2f gui=bold
    highlight VimwikiItalic guifg=#8ec07c gui=italic
    highlight VimwikiLink guifg=#83a598 gui=underline
    highlight VimwikiLink2 guifg=#83a598 gui=underline
    highlight VimwikiURL guifg=#928374 gui=underline

    highlight VimwikiList guifg=#fe8019
    highlight VimwikiTodo guifg=#fb4934 gui=bold
    highlight VimwikiCode guifg=#b8bb26
endfunction
