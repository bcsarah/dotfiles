#!/bin/sh

input=$(printf "poweroff\nreboot\nreload\nexit\nlock" | dmenu $(cat $HOME/dotfiles/themes/current/dmenu) -i -p "power-menu")

[ -z "$input" ] && exit 0

case "$input" in
    poweroff)
        poweroff
        ;;
    reboot)
        reboot
        ;;
    reload)
        i3-msg restart
        ;;
    exit)
        i3-msg exit
        ;;
    lock)
        i3lock -c $(cat $HOME/dotfiles/themes/current/i3lock)
        ;;
esac
