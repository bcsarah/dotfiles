#!/bin/sh

dmenu="dmenu $(cat $HOME/dotfiles/themes/current/dmenu) -i"
notes="notes"
base="$HOME/$notes"

dir=$(ls $base | $dmenu -p "folder")
[ -z "$dir" ] && exit 0

note=$(ls "$base/$dir" | sed 's/\.md$//' | $dmenu -p "notes")
[ -z "$note" ] && exit 0

file="$base/$dir/$note.md"
kitty -d $base -e nvim $file
