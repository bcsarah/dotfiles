set $mod Mod4

# visual
font pango:JetBrainsMono Nerd Font 10
default_border pixel 2

# startup
exec_always --no-startup-id i3-auto-layout
exec_always --no-startup-id picom
exec_always --no-startup-id pkill polybar; polybar
exec --no-startup-id xautolock -time 10 -locker "i3lock -c 2d2d2d" -detectsleep
exec --no-startup-id feh --bg-fill ~/dotfiles/wallpaper.png
exec --no-startup-id redshift -O 4500 -P
exec --no-startup-id greenclip daemon
exec --no-startup-id syncthing --no-browser

# mods
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse yes

# look and feel
set $bg         "#282828"
set $fg         "#ebdbb2"
set $red        "#cc241d"
set $green      "#98971a"
set $yellow     "#d79921"
set $blue       "#458588"
set $purple     "#b16286"
set $aqua       "#689d6a"
set $gray       "#a89984"
set $bg_highlight "#3c3836"

client.focused          $blue $bg_highlight $fg $blue $blue
client.urgent           $red $red $bg $red $red
client.placeholder      $gray $bg $fg $gray $gray
client.background       $bg

gaps inner 10

# binds
bindsym $mod+q exec kitty
bindsym $mod+w kill
bindsym $mod+e exec thunar
bindsym $mod+r exec rofi -show drun
bindsym $mod+Shift+r exec rofi -show run
bindsym $mod+Tab exec rofi -show window
bindsym $mod+Shift+v exec rofi -modi "clipboard:greenclip print" -show clipboard

bindsym $mod+b exec firefox
bindsym $mod+o exec obsidian
bindsym $mod+z exec pavucontrol


# focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# resize
bindsym $mod+plus resize grow width 5 px or 5 ppt
bindsym $mod+minus resize shrink width 5 px or 5 ppt
bindsym $mod+Shift+minus resize shrink height 5 px or 5 ppt
bindsym $mod+Shift+plus resize grow height 5 px or 5 ppt

# layout
bindsym $mod+v floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+y layout tabbed
bindsym $mod+u split toggle

# screenshot
bindsym Print exec --no-startup-id maim --select | xclip -selection clipboard -t image/png
bindsym Ctrl+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png


# workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

bindsym $mod+Shift+1 move container to workspace 1; workspace 1
bindsym $mod+Shift+2 move container to workspace 2; workspace 2
bindsym $mod+Shift+3 move container to workspace 3; workspace 3
bindsym $mod+Shift+4 move container to workspace 4; workspace 4
bindsym $mod+Shift+5 move container to workspace 5; workspace 5


# midia
bindsym XF86AudioPlay exec         playerctl play-pause
bindsym XF86AudioNext exec         playerctl next
bindsym XF86AudioPrev exec         playerctl previous
bindsym XF86AudioRaiseVolume exec  i3-volume -n up 10
bindsym XF86AudioLowerVolume exec  i3-volume -n down 10
bindsym XF86AudioMute exec         i3-volume -n mute
bindsym XF86AudioMicMute exec      i3-volume -n mic mute
bindsym XF86MonBrightnessUp exec   brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-


# reload/quit
bindsym $mod+Shift+c restart
bindsym $mod+Escape exec i3lock -c 2d2d2d
