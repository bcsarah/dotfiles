set $mod Mod4


# startup
exec_always --no-startup-id xwallpaper --zoom ~/.xwallpaper
exec_always --no-startup-id picom
exec --no-startup-id redshift -O 4000 -P


# mods
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse yes


# look and feel
font pango:JetBrainsMono Nerd Font 10
default_border pixel 2
gaps inner 10
include ~/dotfiles/themes/current/i3


# window rule
for_window [class="pavucontrol"] floating enable


# binds
bindsym $mod+q       exec kitty 
bindsym $mod+w       kill
bindsym $mod+e       exec thunar
bindsym $mod+r       exec i3-dmenu-desktop --dmenu="dmenu $(cat ~/dotfiles/themes/current/dmenu)"
bindsym $mod+Shift+r exec dmenu_run $(cat ~/dotfiles/themes/current/dmenu)

bindsym $mod+s exec kitty -e cmus
bindsym $mod+b exec firefox 
bindsym $mod+z exec pavucontrol

bindsym $mod+Shift+c      restart
bindsym $mod+n            exec ~/dotfiles/dmenu/dev
bindsym $mod+Escape       exec ~/dotfiles/dmenu/power-menu
bindsym $mod+Shift+w      exec ~/dotfiles/dmenu/wallpaper
bindsym $mod+Shift+Escape exec ~/dotfiles/dmenu/theme
bindsym $mod+o            exec ~/dotfiles/dmenu/notes


# focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# resize
bindsym $mod+plus        resize grow width 5 px or 5 ppt
bindsym $mod+minus       resize shrink width 5 px or 5 ppt
bindsym $mod+Shift+minus resize shrink height 5 px or 5 ppt
bindsym $mod+Shift+plus  resize grow height 5 px or 5 ppt

# layout
bindsym $mod+v floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+y layout tabbed
bindsym $mod+u split toggle


# screenshot
bindsym Print      exec maim --select | xclip -selection clipboard -t image/png
bindsym Ctrl+Print exec maim | xclip -selection clipboard -t image/png


# workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4

bindsym $mod+Shift+1 move container to workspace 1; workspace 1
bindsym $mod+Shift+2 move container to workspace 2; workspace 2
bindsym $mod+Shift+3 move container to workspace 3; workspace 3
bindsym $mod+Shift+4 move container to workspace 4; workspace 4


# media
bindsym XF86AudioPlay         exec playerctl play-pause
bindsym XF86AudioNext         exec playerctl next
bindsym XF86AudioPrev         exec playerctl previous
bindsym XF86AudioRaiseVolume  exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume  exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute         exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
