* {
    bg: #1c1c1c;
    bg-alt: #353535;
    fg: #d4cfc4;
    fg-alt: #888888;

    red: #a62b2b;
    orange: #c58b49;
    yellow: #f0a35c;
    blue: #7293a5;
    aqua: #83a598;
    purple: #8c697c;
    gray: #4d4d4d;

    background-color: @bg;
    text-color: @fg;
    border-color: @red;
    separatorcolor: @bg-alt;

    selected-normal-background: @red;
    selected-normal-foreground: @fg;

    selected-active-background: @red;
    selected-active-foreground: @fg;

    selected-urgent-background: @red;
    selected-urgent-foreground: @fg;

    alternate-normal-background: @bg;
    alternate-normal-foreground: @fg;

    alternate-active-background: @bg-alt;
    alternate-active-foreground: @fg;

    alternate-urgent-background: @bg;
    alternate-urgent-foreground: @red;

    normal-background: @bg;
    normal-foreground: @fg;

    urgent-background: @bg;
    urgent-foreground: @red;

    active-background: @bg-alt;
    active-foreground: @fg;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 600px;
    padding: 12px;
    border: 2px;
    border-color: @red;
    border-radius: 0px;
    background-color: @bg;
    location: center;
    anchor: center;
}

mainbox {
    border: 0;
    padding: 0;
    background-color: transparent;
    children: ["inputbar", "listview"];
    spacing: 10px;
}

inputbar {
    children: ["prompt", "entry"];
    background-color: @bg-alt;
    border: 0;
    border-radius: 0;
    padding: 10px;
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @red;
    padding: 0 6px 0 0;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "  Type to search...";
    placeholder-color: @fg-alt;
    cursor: text;
}

listview {
    lines: 10;
    columns: 1;
    background-color: transparent;
    border: 0;
    padding: 0;
    spacing: 4px;
    scrollbar: false;
    cycle: true;
    dynamic: true;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 0;
    spacing: 12px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: @bg;
    text-color: @fg;
}

element selected.normal {
    background-color: @red;
    text-color: @fg;
}

element alternate.normal {
    background-color: @bg;
    text-color: @fg;
}

element urgent.normal {
    background-color: @red;
    text-color: @fg;
}

element.selected.urgent {
    background-color: @red;
    text-color: @fg;
}

element-text highlight {
    text-color: @yellow;
}

element selected highlight {
    text-color: @bg;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-width: 4px;
    handle-color: @red;
    background-color: @bg-alt;
    padding: 0;
}

mode-switcher {
    background-color: transparent;
    spacing: 8px;
    padding: 6px 0 0 0;
}

button {
    padding: 6px 10px;
    background-color: @bg-alt;
    text-color: @fg-alt;
    border-radius: 0;
    border: 0;
}

button selected {
    background-color: @red;
    text-color: @fg;
}

message {
    background-color: @bg-alt;
    border: 2px;
    border-color: @red;
    border-radius: 0;
    padding: 10px;
}

textbox {
    background-color: transparent;
    text-color: @fg;
    padding: 6px;
}
