    { "type": "packages", "key": "󰏖 " },
    { "type": "shell", "key": " " },

    "break",

    { "type": "cpu", "key": "󰍛 "},
    { "type": "memory", "key": " " },
    { "type": "disk", "key": "󱛟 ", "folders": ["/"] },
    { "type": "wm", "key": " " },

