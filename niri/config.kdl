hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

// Workspaces
workspace "1"
workspace "2"
workspace "3"

// Switch Events
switch-events {
    lid-close {
        spawn "systemctl" "suspend";
    }
}

// Startup
spawn-sh-at-startup "swaybg -i ~/.wpp"
spawn-sh-at-startup "wlsunset -T 4001 -t 4000"
spawn-sh-at-startup "syncthing --no-browser"


// Input
input {
    keyboard {
        xkb {
            layout "br"
            variant "abnt2"
        }
    }

    touchpad {
        tap
        natural-scroll
        scroll-method "two-finger"
    }

    warp-mouse-to-focus
}


// Layout
layout {
    gaps 4
    always-center-single-column

    focus-ring {
        off
    }
}


// Binds
binds {
    // Bind apps
    Mod+Q       { spawn "foot"; }
    Mod+W       { close-window; }
    Mod+E       { spawn "thunar"; }
    Mod+R       { spawn-sh "rofi -show drun"; }
    Mod+Shift+R { spawn-sh "rofi -show run"; }
    Mod+Tab     { toggle-overview; }

    Mod+S { spawn-sh "foot -e cmus"; }
    Mod+B { spawn "firefox"; }
    Mod+M { spawn "rofimoji"; }
    Mod+Z { spawn "pavucontrol"; }

    Mod+Escape  { spawn "~/dotfiles/scripts/power-menu"; }
    Mod+Shift+W { spawn "~/dotfiles/scripts/wpp"; }
    Mod+N       { spawn "~/dotfiles/scripts/dev"; }
    Mod+O       { spawn "~/dotfiles/scripts/notes"; }

    // Window Management
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-to-workspace-down; }
    Mod+Shift+K { move-window-to-workspace-up; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp   { focus-column-left; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }

    // Presets
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }
    Mod+V       { toggle-window-floating; }

    // Media
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop         allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set +10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set 10%-"; }

    // Printscreen
    Print           { screenshot; }
    Mod+Print       { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }
}


// Window Rules
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
    
    background-effect {
        blur true
    }
}

window-rule {
    match is-focused=true
    opacity 0.95
}

window-rule {
    match is-focused=false
    opacity 0.9
}

// Firefox
window-rule {
    match app-id="firefox"
    open-on-workspace "2"
    open-maximized true
}

window-rule {
    match title="Picture-in-Picture"
    open-floating true
}

// Gamez
window-rule {
    match app-id="steam"
    match app-id="sh.ppy.osu"
    match app-id="org.vinegarhq.Sober"
    match app-id="Fightcade"
    open-on-workspace "3"
    open-maximized true
}

// Thunar
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

// Pavucontrol
window-rule {
    match title="File Operation Progress"
    open-floating true
}
