{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "top": 4,
      "left": 3
    }
  },

  "display": {
    "separator": " ",
  },

  "modules": [
    "title",

    "break",

    { "type": "battery",  "key": "󰁹 " },
    { "type": "datetime", "key": "󰥔 " },

    "break",

    { "type": "os",       "key": " " },
    { "type": "kernel",   "key": "󰇺 " },
    { "type": "packages", "key": "󰏖 " },

    "break",

    { "type": "memory",   "key": " " },
    { "type": "disk",     "key": "󱛟 ", "folders": ["/"] },
    { "type": "wm",       "key": " " },

    "break",

    { "type": "colors" }
  ]
}
