{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "top": 3,
      "left": 3
    }
  },

  "display": {
    "separator": " ",
  },

  "modules": [
    "title",
    "break",

    { "type": "os",       "key": " " },
    { "type": "kernel",   "key": "󰇺 " },
    { "type": "packages", "key": "󰏖 " },
    { "type": "shell",    "key": " " },

    "break",

    { "type": "cpu",      "key": "󰍛 ", "format": "{name} @ {freq-max}"},
    { "type": "memory",   "key": " " },
    { "type": "disk",     "key": "󱛟 ", "folders": ["/"] },
    { "type": "wm",       "key": " " },

    "break",

    { "type": "colors" }
  ]
}
