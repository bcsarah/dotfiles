{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "small",
    "color": {
      "1": "red",
      "2": "red"
    },
    "padding": {
      "top": 3,
      "left": 3
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },

  "modules": [
    { "type": "title" },

    "break",

    { "type": "battery",  "key": "󰁹 " },
    { "type": "datetime", "key": "󰸗 " },

    "break",

    { "type": "os",       "key": " " },
    { "type": "kernel",   "key": "󰇺 " },
    { "type": "packages", "key": "󰏖 " },
    { "type": "command",  "key": "󰥔 ", "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(((now - birth) / 86400)) days" },

    "break",

    { "type": "memory",   "key": " " },
    { "type": "disk",     "key": "󱛟 ", "folders": ["/"] },
    { "type": "wm",       "key": " " },

    "break"
  ]
}
